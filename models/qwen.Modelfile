# Second local LLM for the BPM-GenAI project (Steps 3-5).
# Build:  ollama create bpm-qwen -f models/qwen.Modelfile
# Base: Qwen 2.5 Coder 14B (Alibaba, Q4_K_M, ~9 GB) - a different model family from Gemma,
# trained for code generation; fits in the 16 GB VRAM of the RX 9070 XT.
FROM qwen2.5-coder:14b

# Deterministic output, so runs are reproducible for the Step 6-7 comparisons
PARAMETER temperature 0
PARAMETER top_k 1
PARAMETER seed 42

# Room for the log schema + system prompt + generated code
PARAMETER num_ctx 16384
